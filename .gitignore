# ==========================================
# Dependencies
# ==========================================
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# Build Artifacts & Production
# ==========================================
**/.next/
**/out/
backend/bin/
build/
coverage/
.vercel/

# ==========================================
# Playwright
# ==========================================
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# ==========================================
# Executables & Backup Files
# ==========================================
*.exe
*.exe~
*.bak
*.tsbuildinfo
next-env.d.ts

# ==========================================
# Environment Variables & Sensitive Data
# ==========================================
.env
.env.*
*.env
!.env.example
*token*.json
gdrive.json
invites.json

# ==========================================
# Local Runtime Data & Storage
# ==========================================
backend/data/

# ==========================================
# Local Toolchain & Database Cluster
# ==========================================
.tools/
.pgdata/

# ==========================================
# Dokumentasi (lokal saja, tidak di-push)
# ==========================================
docs/
*.docx
IDEA.md
ROADMAP.md
agent.md
AGENTS.md
**/AGENTS.md
# Pengecualian: frontend/AGENTS.md ditulis ulang oleh `next dev` dan dirujuk
# CODEBUDDY.md, jadi ikut di-commit.
!frontend/AGENTS.md

# Dokumentasi publik tetap ikut di-push, termasuk nama file yang
# sekaligus di-ignore di atas (ROADMAP.md, AGENTS.md).
!documentation/
!documentation/**

# ==========================================
# Mockup / Screenshot
# ==========================================
frontend/public/Kolase*

# ==========================================
# Debug Logs & OS/IDE
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
