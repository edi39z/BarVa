# ==============================================================================
# Barva — contoh konfigurasi Docker Compose
# ==============================================================================
# Salin file ini menjadi .env lalu isi nilainya:
#
#     cd deploy/docker
#     cp .env.example .env
#
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# ==============================================================================

# WAJIB. Password untuk user PostgreSQL "nas_admin".
# Gunakan huruf dan angka saja. Karakter khusus seperti @ : / ? # akan
# merusak DATABASE_URL yang dirakit dari nilai ini.
# Compose menolak start bila nilainya kosong.
POSTGRES_PASSWORD=

# WAJIB. Kunci untuk endpoint /gdrive/* dan /invites/*.
# Backend menolak start (GIN_MODE=release) bila nilainya kosong atau masih
# berupa nilai contoh: di dalam Docker semua request datang dari IP privat
# proxy, sehingga tanpa kunci endpoint admin terbuka bagi siapa pun yang bisa
# menjangkau server.
# Buat nilai acak (minimal 32 karakter) dengan: openssl rand -hex 32
NAS_ADMIN_KEY=

# WAJIB. Alamat publik aplikasi, dipakai untuk redirect OAuth Google Drive
# dan link undangan. Isi dengan alamat yang dibuka pengguna, bukan localhost,
# bila server diakses dari perangkat lain.
# Contoh: http://192.168.1.10:3000
APP_URL=

# Opsional. Origin frontend tambahan untuk CORS, dipisah koma.
# Contoh: http://192.168.1.10:3000,https://nas.contoh.id
ALLOWED_ORIGINS=

# Opsional. Batas ukuran satu upload dalam byte.
# Kosong = default 10 GiB (10737418240).
MAX_UPLOAD_BYTES=
