# Contoh environment untuk unit systemd Barva.
#
# Salin ke /etc/nas/backend.env, lalu batasi izinnya:
#
#   sudo install -d -m 750 /etc/nas
#   sudo cp deploy/systemd/backend.env.example /etc/nas/backend.env
#   sudo chown root:nas /etc/nas/backend.env
#   sudo chmod 640 /etc/nas/backend.env
#
# File ini TIDAK boleh di-commit. Nilai di bawah masih placeholder.

# Wajib. Ganti password dengan nilai acak milik sendiri.
# Gunakan huruf dan angka saja: karakter seperti @ : / ? # merusak URL.
DATABASE_URL=postgres://nas:GANTI_PASSWORD@localhost:5432/nas_db?sslmode=disable

# Wajib di GIN_MODE=release. Backend menolak start bila kosong, masih berupa
# nilai contoh, atau kurang dari 32 karakter.
# Buat dengan: openssl rand -hex 32
NAS_ADMIN_KEY=

# Wajib. Alamat aplikasi yang dibuka pengguna, dipakai untuk redirect OAuth
# Google Drive dan link undangan.
# Contoh: http://192.168.1.10:3000
APP_URL=

# Opsional. Origin frontend tambahan untuk CORS, dipisah koma.
# ALLOWED_ORIGINS=https://nas.contoh.id

# Opsional. Batas ukuran satu upload dalam byte. Kosong = 10 GiB.
# MAX_UPLOAD_BYTES=10737418240
