[Unit]
Description=Barva Backend Daemon (Go Modular Monolith)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=nas
Group=nas
WorkingDirectory=/opt/nas/backend
ExecStart=/opt/nas/backend/bin/server
Restart=always
RestartSec=5s

# Environment Variables
#
# Hanya nilai non-rahasia yang ditulis di sini. DATABASE_URL dan NAS_ADMIN_KEY
# berisi kredensial, jadi dibaca dari file terpisah yang tidak ikut repo:
#
#   sudo install -d -m 750 /etc/nas
#   sudo cp deploy/systemd/backend.env.example /etc/nas/backend.env
#   sudo chown root:nas /etc/nas/backend.env
#   sudo chmod 640 /etc/nas/backend.env
#   # lalu isi nilainya, contoh: sudo -e /etc/nas/backend.env
#
# File itu wajib ada: GIN_MODE=release membuat backend menolak start bila
# NAS_ADMIN_KEY kosong.
Environment="PORT=8080"
Environment="STORAGE_DIR=/opt/nas/data/storage"
Environment="TEMP_DIR=/opt/nas/data/tmp"
Environment="MIGRATIONS_DIR=/opt/nas/migrations"
Environment="GIN_MODE=release"
EnvironmentFile=/etc/nas/backend.env

# Security & Isolation Hardening
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
